{
  "name": "opencare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "db:reset": "supabase db reset",
    "db:test": "bash scripts/db-test.sh",
    "test:composer": "npx --yes tsx scripts/test-composer.ts",
    "test:chart": "npx --yes tsx scripts/test-chart.ts && npx --yes tsx --tsconfig tsconfig.app.json scripts/test-chart-visit.ts",
    "test:screens": "npx --yes tsx scripts/test-screens.ts",
    "test:sections": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-sections.ts",
    "test:banner": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-banner.ts",
    "test:settings": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-settings.ts",
    "test:board": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-board.ts",
    "test:scores": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-scores.ts",
    "test:demo": "npx --yes tsx scripts/test-demo.ts",
    "test:setups": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-setups.ts",
    "test:registries": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-registries.ts",
    "test:pharmacy": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-pharmacy.ts",
    "test:lis": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-lis.ts",
    "test:billing": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-billing.ts && npx --yes tsx --tsconfig tsconfig.app.json scripts/test-billing-print.ts",
    "test:print": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-print.ts",
    "test:radiology": "npx --yes tsx --tsconfig tsconfig.app.json scripts/test-radiology.ts",
    "gen:types": "supabase gen types typescript --local --schema public > src/core/db/types.generated.ts",
    "gen:shapes": "npx --yes tsx scripts/gen-shapes.ts",
    "gen:logins": "npx --yes tsx scripts/gen-logins.ts",
    "db:demo": "bash scripts/demo.sh",
    "db:import-codes": "bash scripts/import-codes.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.1.0"
  }
}
